# Root-level configuration for `docker compose up`. Per-service defaults live in
# gateway/.env.example, ml/.env.example and web/.env.example.

# REQUIRED. At least 32 random bytes: `openssl rand -base64 48`
JWT_SECRET=
# REQUIRED. Shared secret between the gateway and the ML service.
INTERNAL_API_KEY=

# Optional: enable the clinical advisory layer.
OPENAI_API_KEY=
LLM_ENABLED=0
RAG_ENABLED=0

# The URL the browser uses to reach the gateway.
NEXT_PUBLIC_API_URL=http://localhost:8081
