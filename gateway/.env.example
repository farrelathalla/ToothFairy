# Copy to gateway/.env and adjust. Every value has a development default in internal/config.

# development | production. With ENV=production the server REFUSES to start on a development
# JWT secret or a missing internal key, so a misconfigured deployment fails loudly.
ENV=development
ADDR=:8081

# SQLite file. Created (with its parent directory) on first boot.
DATABASE_URL=./data/toothfairy.db
# Uploaded patient photos. Must be a path the ML service can also read.
UPLOAD_DIR=./data/uploads
# Inference output, shared with the web app which serves it statically.
RESULTS_DIR=../web/public/results
# Demo accounts and cases loaded on boot (idempotent).
SEED_DIR=../assets/seed

# CHANGE THIS. At least 32 random bytes: `openssl rand -base64 48`
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MIN=720

# The Python ML service. Keep it on a private network — only the gateway should reach it.
ML_BASE_URL=http://localhost:8000
# Generous: a real analysis is minutes on CPU.
ML_TIMEOUT_S=1800
# Shared secret presented on every internal call. Must match ml/.env. Required in production.
INTERNAL_API_KEY=

# Concurrent analyses, and how many may wait. A full queue returns 503 + Retry-After rather
# than letting a request hang.
JOB_WORKERS=2
JOB_QUEUE_SIZE=64

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
# Per uploaded file.
MAX_UPLOAD_MB=12
# Per client IP, per minute. 0 disables.
RATE_LIMIT_RPM=240
# Only enable behind a load balancer you control — otherwise a client can spoof
# X-Forwarded-For and walk past the rate limiter.
TRUSTED_PROXY=false
