# Copy to backend/.env and adjust. All have sane defaults in config.py.
DATABASE_URL=sqlite:///./data/toothfairy.db
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MIN=720
# Shared with the frontend: inference results are written here and served by Next statically.
RESULTS_DIR=../app/public/results
UPLOAD_DIR=./data/uploads
# 1 = skip heavy models, copy a precomputed demo dataset (fast dev/E2E).
MOCK_INFERENCE=0
# Comma-separated allowed origins for CORS (frontend dev server).
CORS_ORIGINS=http://localhost:3000

# ── LLM / RAG advisory layer ────────────────────────────────────────────────────
# Both OFF by default: pytest + E2E must exercise the deterministic stub and never call out.
ANTHROPIC_API_KEY=
LLM_ENABLED=0
RAG_ENABLED=0
LLM_MODEL=claude-sonnet-5
LLM_HELPER_MODEL=claude-haiku-4-5
LLM_EFFORT=high
LLM_MAX_TOKENS=12000
# Hybrid search fetches RAG_CANDIDATES, the cross-encoder reranks down to RAG_TOP_N.
RAG_CANDIDATES=16
RAG_TOP_N=6
