# Copy to ml/.env and adjust. All values have sane defaults in app/config.py.

# Where inference results are written; served statically by the web app.
RESULTS_DIR=../web/public/results
UPLOAD_DIR=./data/uploads
# 1 = skip the heavy vision models and copy a precomputed demo dataset (fast dev/E2E).
MOCK_INFERENCE=0
# Comma-separated allowed origins (web dev server, Go gateway).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Shared secret the Go gateway presents on /internal/* calls. Leave blank ONLY for local dev.
INTERNAL_API_KEY=

# ── LLM / RAG advisory layer ────────────────────────────────────────────────────
# Both flags default OFF: pytest + E2E must exercise the deterministic stub and never call out.
OPENAI_API_KEY=
LLM_ENABLED=0
RAG_ENABLED=0
# Optional: Azure OpenAI / self-hosted gateway base URL.
OPENAI_BASE_URL=
LLM_MODEL=gpt-5.6-sol
LLM_HELPER_MODEL=gpt-5.6-luna
LLM_EFFORT=high
LLM_MAX_TOKENS=12000
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
# Screen free-text patient input with the moderation endpoint before it reaches the prompt.
MODERATION_ENABLED=0
# Hybrid search fetches RAG_CANDIDATES, the cross-encoder reranks down to RAG_TOP_N.
RAG_CANDIDATES=16
RAG_TOP_N=6
